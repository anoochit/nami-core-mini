# Nami Mini Agent Environment Variables

# Google Gemini API Key (Required for default gemini provider)
# Also powers the media sub-agent: image / TTS / music / video generation
# (see nami.json "media" section; assembly/MP3 conversion uses local ffmpeg).
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: Other LLM Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Serper.dev API Key for the Google Search tool (https://serper.dev)
SERPER_API_KEY=your_serper_api_key_here

# Application Log Level (error, warn, info, debug, trace)
RUST_LOG=nami_mini=info,adk_rust=info

# HTTP Server Port for `cargo run -- serve` (Default: 8080)
PORT=8080
